#include <windows.h>

1 ICON "win/yanas.ico"
1 24 "win/yanas.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "yanas"
      VALUE "FileDescription", "yanas net network simulator"
      VALUE "FileVersion", "0.1.0.0"
      VALUE "InternalName", "netsim"
      VALUE "OriginalFilename", "netsim.exe"
      VALUE "ProductName", "yanas net"
      VALUE "ProductVersion", "0.1.0.0"
      VALUE "LegalCopyright", "Copyright (c) 2026 yanas"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
