CXX ?= g++
CC := gcc
CXXFLAGS ?= -std=c++17 -Wall -Wextra -O2 -I.
CXXFLAGS += -DHAVE_LUA -Ithird_party/lua

LIB_SRCS := $(wildcard core/*.cpp) $(wildcard device/*.cpp) $(wildcard link/*.cpp) $(wildcard engine/*.cpp) $(wildcard topo/*.cpp)
CLI_SRCS := app/main.cpp script/LuaScript.cpp
LUA_SRCS := $(wildcard third_party/lua/*.c)
LUA_OBJS := $(LUA_SRCS:.c=.o)
RES := win/yanas_res.o
CLI := netsim.exe

.PHONY: all clean cli

all: $(CLI)
cli: $(CLI)

$(RES): win/yanas.rc win/yanas.manifest win/yanas.ico
	windres win/yanas.rc -O coff -o $(RES)

$(CLI): $(LIB_SRCS) $(CLI_SRCS) $(LUA_OBJS) $(RES)
	$(CXX) $(CXXFLAGS) $(LIB_SRCS) $(CLI_SRCS) $(LUA_OBJS) $(RES) -o $(CLI) -lm

third_party/lua/%.o: third_party/lua/%.c
	$(CC) -O2 -Ithird_party/lua -c $< -o $@

clean:
	if exist $(CLI) del /Q $(CLI)
	if exist $(RES) del /Q $(RES)
	if exist third_party\lua\*.o del /Q third_party\lua\*.o
